# Homebrew PostgreSQL uses the current macOS user by default.
DATABASE_URL=postgresql://localhost:5432/storyteller
# Generate once with: openssl rand -base64 32
PLATFORM_CREDENTIALS_KEY=
WEB_ORIGIN=http://localhost:3000
# Browser-safe Amplitude project key. Leave blank to disable analytics.
VITE_AMPLITUDE_API_KEY=
# Must match the Amplitude organization data region: EU or US.
VITE_AMPLITUDE_SERVER_ZONE=EU
# The API relay uses the same project key and region. Leave the key blank to
# keep the relay unavailable.
AMPLITUDE_API_KEY=
AMPLITUDE_SERVER_ZONE=EU
# Local development stores originals without recompression in the repository.
MEDIA_STORAGE_DRIVER=local
MEDIA_ROOT=.storyteller-media
# Temporary files are used only while sharp/ffprobe inspect an upload.
# MEDIA_TEMP_ROOT=/tmp

# Production: set MEDIA_STORAGE_DRIVER=s3 and connect these values to a private
# Railway Storage Bucket (or another S3-compatible provider).
# S3_BUCKET=
# S3_ENDPOINT=https://storage.railway.app
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_DOWNLOAD_URL_TTL_SECONDS=3600 # 1 second to 7 days
